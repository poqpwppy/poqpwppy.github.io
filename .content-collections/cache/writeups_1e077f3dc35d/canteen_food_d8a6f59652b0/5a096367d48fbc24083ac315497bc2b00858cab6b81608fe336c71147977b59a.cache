point.sh\"]\n`})}),`\n`,(0,n.jsxs)(l.p,{children:[\"N\\u1ED9i dung file n\\xE0y ch\\u1EC9 l\\xE0 nh\\u1EEFng c\\xE2u l\\u1EC7nh \\u0111\\u1EC3 t\\u1EA1o ra 1 m\\xE1y ch\\u1EE7 web ch\\u1EA1y b\\u1EB1ng \",(0,n.jsx)(l.code,{children:\"PHP 7.1\"}),\", c\\xE0i s\\u1EB5n \",(0,n.jsx)(l.code,{children:\"MariaDB\"}),\".\"]}),`\n`,(0,n.jsxs)(l.h5,{id:\"entrypointsh\",children:[\"entrypoint.sh\",(0,n.jsx)(l.a,{className:\"heading-anchor\",\"aria-label\":\"Link to this section\",href:\"#entrypointsh\",children:(0,n.jsx)(l.span,{className:\"icon icon-link\"})})]}),`\n`,(0,n.jsxs)(l.div,{className:\"codeblock\",children:[`\n  `,(0,n.jsxs)(l.div,{className:\"codeblock-bar\",children:[`\n    \n    `,(0,n.jsx)(l.span,{className:\"codeblock-lang\",children:\"bash\"}),`\n    `,(0,n.jsx)(l.button,{type:\"button\",className:\"codeblock-copy\",\"data-code\":\"\",\"aria-label\":\"Copy code\",children:\"copy\"}),`\n  `]}),`\n  `,(0,n.jsx)(l.pre,{className:\"shiki github-dark-default\",style:{backgroundColor:\"#0d1117\",color:\"#e6edf3\"},tabIndex:\"0\",children:(0,n.jsxs)(l.code,{children:[(0,n.jsx)(l.span,{className:\"line\",children:(0,n.jsx)(l.span,{style:{color:\"#8B949E\"},children:\"#!/bin/bash\"})}),`\n`,(0,n.jsx)(l.span,{className:\"line\"}),`\n`,(0,n.jsxs)(l.span,{className:\"line\",children:[(0,n.jsx)(l.span,{style:{color:\"#FFA657\"},children:\"chmod\"}),(0,n.jsx)(l.span,{style:{color:\"#79C0FF\"},children:\" 600\"}),(0,n.jsx)(l.span,{style:{color:\"#A5D6FF\"},children:\" /entrypoint.sh\"})]}),`\n`,(0,n.jsx)(l.span,{className:\"line\"}),`\n`,(0,n.jsxs)(l.span,{className:\"line\",children:[(0,n.jsx)(l.span,{style:{color:\"#FFA657\"},children:\"mkdir\"}),(0,n.jsx)(l.span,{style:{color:\"#79C0FF\"},children:\" -p\"}),(0,n.jsx)(l.span,{style:{color:\"#A5D6FF\"},children:\" /run/mysqld\"})]}),`\n`,(0,n.jsxs)(l.span,{className:\"line\",children:[(0,n.jsx)(l.span,{style:{color:\"#FFA657\"},children:\"chown\"}),(0,n.jsx)(l.span,{style:{color:\"#79C0FF\"},children:\" -R\"}),(0,n.jsx)(